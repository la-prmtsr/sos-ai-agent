# Salin file ini menjadi ".env" (tanpa .example), lalu isi.
# JANGAN pernah upload file .env ke GitHub.

# ------------------------------------------------------------ Telegram
# Token dari @BotFather. Kosong = bot tidak jalan (dashboard tetap bisa dites).
TELEGRAM_BOT_TOKEN=

# ID Telegram relawan terdaftar, pisahkan dengan koma. Mereka dapat trust score 0.95.
# Cek ID kamu dengan mengetik /id ke bot.
REGISTERED_VOLUNTEERS=

# ---------------------------------------------------------- Blockchain
# Kosongkan CONTRACT_ADDRESS untuk "mode tanpa chain" (approve lewat tombol biasa).
#
# Lokal (Hardhat node):
#   RPC_URL=http://127.0.0.1:8545
#   CHAIN_ID=31337
# BSC testnet:
#   RPC_URL=https://bsc-testnet-rpc.publicnode.com
#   CHAIN_ID=97
#   EXPLORER_URL=https://testnet.bscscan.com
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CHAIN_NAME=Hardhat Lokal
EXPLORER_URL=
CONTRACT_ADDRESS=

# Private key wallet backend (relayer). Harus wallet yang didaftarkan sebagai
# relayer saat deploy. Pakai wallet khusus testnet, jangan wallet berisi uang asli.
RELAYER_PRIVATE_KEY=

# ------------------------------------------------------ Pos asal bantuan
# Titik berangkat bantuan diambil dari backend/data/bpbd_staging_areas.json (38 BPBD provinsi).
# Agent 2 memilih pos terdekat ke lokasi laporan, jadi bagian ini TIDAK perlu diisi.
# Untuk menambah pos (misalnya BPBD kabupaten), tambah baris di file JSON itu.
#
# Berapa pos terdekat yang dibandingkan waktu tempuhnya, dan di atas berapa km
# kartu dispatch diberi peringatan "pos asal jauh":
# STAGING_CANDIDATES=3
# STAGING_FAR_KM=150
#
# Cadangan: hanya dipakai kalau file JSON di atas tidak ada atau kosong.
# DEPOT_NAME=Pusdalops BPBD Provinsi DKI Jakarta
# DEPOT_LAT=-6.1643
# DEPOT_LON=106.8142

# ------------------------------------------------------ LLM (opsional)
# Dipakai Supervisor Agent untuk menulis alasan rekomendasi.
# Kosong = pakai kalimat template, semua fitur lain tetap jalan.
# Bisa provider apa pun yang kompatibel dengan format OpenAI, contoh base URL:
#   OpenAI        https://api.openai.com/v1
#   Kimi/Moonshot https://api.moonshot.ai/v1
#   Groq          https://api.groq.com/openai/v1
# Cek dokumentasi provider untuk base URL dan nama model yang benar.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Isi true kalau LLM_MODEL bisa membaca gambar. Dipakai Agent 2 untuk menilai snapshot
# CCTV (daftar kamera ada di backend/data/cctv.csv).
LLM_VISION=false

# ------------------------------------------- Verifikasi Agent 2 (opsional)
# Cek penduduk: estimasi WorldPop dalam radius POP_RADIUS_KM dari titik laporan.
# Tidak butuh API key. Isi false kalau layanannya lambat dari jaringanmu.
WORLDPOP_ENABLED=true
POP_RADIUS_KM=2
# Batas waktu menunggu (detik). Hasil yang berhasil disimpan di backend/data/cache_*.json,
# jadi lokasi yang sama tidak menunggu lagi.
WORLDPOP_TIMEOUT=15
BPS_TIMEOUT=10

# Key WebAPI BPS (webapi.bps.go.id). Dipakai untuk angka resmi kecamatan/kabupaten
# sebagai cek silang. Kabupaten yang didukung didaftarkan di backend/data/bps_wilayah.csv.
BPS_API_KEY=

# Key gratis NASA FIRMS (firms.modaps.eosdis.nasa.gov, menu "MAP KEY"). Opsional.
# Dipakai untuk mencocokkan laporan KEBAKARAN dengan titik api dari satelit.
FIRMS_MAP_KEY=

# Konfirmasi silang: laporan dari pelapor lain dalam radius dan rentang waktu ini
# dianggap menguatkan laporan baru.
NEARBY_KM=3
NEARBY_HOURS=24

# Radius pencarian baris di backend/data/penduduk_desa.csv dan kamera di cctv.csv.
CENSUS_MAX_KM=1
CCTV_MAX_KM=5

# ---------------------------------------------------------------- Lain
# Tombol "Buat laporan contoh" di dashboard. Matikan (false) kalau di-hosting publik.
ALLOW_SIMULATE=true
