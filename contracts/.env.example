# Salin file ini menjadi ".env" (tanpa .example), lalu isi.
# JANGAN pernah upload file .env ke GitHub.

# Private key wallet yang dipakai untuk deploy ke BSC testnet.
# Pakai akun MetaMask BARU khusus testnet, jangan akun yang ada uang aslinya.
DEPLOYER_PRIVATE_KEY=

# Opsional. Kosongkan untuk pakai RPC publik bawaan.
BSC_TESTNET_RPC=

# Opsional. Alamat wallet backend (relayer). Kosong = sama dengan deployer.
RELAYER_ADDRESS=

# Opsional. Alamat wallet operator, pisahkan dengan koma. Kosong = deployer.
OPERATOR_ADDRESSES=
